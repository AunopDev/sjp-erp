PORT=3000
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-bytes
DATABASE_PATH=./data/sjp.sqlite
CORS_ORIGIN=http://localhost:4200
# lax (same-site), strict หรือ none (ต้องใช้ HTTPS)
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false
APP_TIMEZONE=Asia/Bangkok
UPLOAD_DIR=./data/uploads
# คีย์เข้ารหัสไฟล์สำรอง (ถ้าเว้นว่างจะใช้ JWT_SECRET)
BACKUP_ENCRYPTION_KEY=
# PDF rendering (leave blank to auto-detect Chrome/Edge)
PDF_BROWSER_PATH=
# Email fallback (can also be configured in Settings > แจ้งเตือน)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=
# เปิดเฉพาะเมื่อต้องใช้ SMTP ภายในองค์กร (ระวัง SSRF)
SMTP_ALLOW_PRIVATE=false
# LINE Messaging API fallback
LINE_CHANNEL_TOKEN=
LINE_TO=
# เปิดเฉพาะเมื่อต้องส่ง webhook ไปยัง localhost/เครือข่ายภายใน (ระวัง SSRF)
WEBHOOK_ALLOW_PRIVATE=false
# ตั้งเป็น 1 เมื่ออยู่หลัง reverse proxy ที่ส่ง X-Forwarded-For (สำหรับ rate limit ต่อ IP)
TRUST_PROXY=0
